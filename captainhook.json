{
  "pre-commit": {
    "enabled": true,
    "actions": [
      { "action": "php vendor\\bin\\php-cs-fixer fix --diff" },
      { "action": "git add ." }
    ]
  },
  "pre-push": {
    "enabled": true,
    "actions": [
      { "action": "php vendor\\bin\\phpstan analyse" },
      { "action": "php vendor\\bin\\phpunit tests" }
    ]
  }
}
